.nx/workspace-data

# All env variants: any of these can carry KEEPER_PRIVATE_KEY or RPC secrets.
.env
.env.*
!.env.example
!.env.mainnet.example

# Operator-local key material and key-derived files: never part of the repository.
apps/keeper/.keeper-address
*.pem
*.key
credentials.json
.venv*/

