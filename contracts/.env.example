# For a MAINNET ceremony start from .env.mainnet.example instead: it carries the launch
# policy and the preflight (scripts/preflight-mainnet.ts) checks every value against the chain.

# Required: token and feed addresses on target chain (mainnet inventory, docs/ORACLES.md section 1)
PAXG_TOKEN=0x45804880De22913dAFE09f4980848ECE6EcbAf78
XAUT_TOKEN=0x68749665FF8D2d112Fa859AA293F07A622782F38
# Chainlink PAXG/USD. An earlier copy of this file listed 0x9B97304EA12EFed0FAd976FBeCAad46016bf269e,
# which is not an AggregatorV3 contract.
PAXG_FEED=0x9944D86CEB9160aF5C5feB251FD671923323f8C3
# Chainlink XAU/USD spot, XAUT's dormant proxy while the XAUT ceiling is zero
XAUT_FEED=0x214eD9Da11D2fbe465a6fc601a91E62EbEc1a0D6
# Mandatory on mainnet: the oracle's cross-feed anchor
XAU_USD_ANCHOR_FEED=0x214eD9Da11D2fbe465a6fc601a91E62EbEc1a0D6

# Required: governance multisig addresses (comma-separated for multiple)
TIMELOCK_PROPOSER=0xYourProposerMultisig
TIMELOCK_EXECUTOR=0xYourExecutorMultisig
TIMELOCK_GUARDIAN=0xYourGuardianMultisig

# Required: RPC and deployer key
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=0xYourDeployerPrivateKey

# Optional: override defaults (deploy.ts ships both ceilings at 0; raise them through the timelock)
# STALENESS_THRESHOLD=90000
# SILO_CAP=100000000000000000000
# PAXG_MIN_RATIO=1300000
# PAXG_LIQ_RATIO=1100000
# PAXG_LIQ_PENALTY=50000
# PAXG_DEBT_CEILING=0
# XAUT_MIN_RATIO=1300000
# XAUT_LIQ_RATIO=1100000
# XAUT_LIQ_PENALTY=50000
# XAUT_DEBT_CEILING=0
# PAXG_STABILITY_FEE_BPS=200
# XAUT_STABILITY_FEE_BPS=200

# Optional: gas reporting
# REPORT_GAS=true
# GAS_REPORT_FILE=gas-report.txt

# Optional: Etherscan verification
# ETHERSCAN_API_KEY=YOUR_KEY
