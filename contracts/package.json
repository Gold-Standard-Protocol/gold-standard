{
  "name": "@goldstandard/contracts",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "test:gas:report": "REPORT_GAS=true GAS_REPORT_FILE=gas-report.txt hardhat test",
    "coverage": "hardhat coverage",
    "coverage:check": "hardhat coverage && node scripts/check-coverage.js",
    "typecheck": "tsc --noEmit -p .",
    "lint": "solhint 'src/**/*.sol' 'research/**/*.sol'",
    "lint:fix": "solhint 'src/**/*.sol' 'research/**/*.sol' --fix",
    "slither": "hardhat compile && slither . --config-file slither.config.json --hardhat-ignore-compile",
    "deploy": "hardhat run scripts/deploy.ts",
    "verify-deployment": "hardhat run scripts/verify-deployment.ts",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "2.29.1",
    "hardhat-gas-reporter": "^1.0.10",
    "solhint": "^5.0.3",
    "solidity-coverage": "^0.8.12"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "overrides": {
    "lodash": "4.18.1",
    "@ethersproject/providers": {
      "ws": "8.22.1"
    }
  }
}
