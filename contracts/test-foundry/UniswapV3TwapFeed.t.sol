import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
import {TickPower} from "../research/oracle/TickPower.sol";
import {UniswapV3TwapFeed} from "../research/oracle/UniswapV3TwapFeed.sol";
import {TickPowerHarness} from "../research/mocks/TickPowerHarness.sol";
