/// @notice Shared helpers: an independent decimal expectedValue for 1.0001^n and a relative comparison
///         of two binary floating point values.
abstract contract TwapFeedTestBase is Test {
    uint256 internal constant WAD60 = 1e60;
    /// @dev 1.0001 at 60 decimals. Decimal arithmetic shares nothing with TickPower's binary routine.
    uint256 internal constant DECIMAL_BASE = 10001 * 1e56;
    /// @dev Relative tolerance 1e-30: TickPower's worst case error is about 1.3e-32.
    uint256 internal constant REL_TOLERANCE = 1e30;

    /// @dev 1.0001^n scaled by 1e60, by left to right decimal squaring with 512 bit mulDiv. The base is
    ///      squared only while a higher bit remains, which keeps it below 1e77 for n under 2^19.
    function decimalPow(uint256 n) internal pure returns (uint256 r) {
        r = WAD60;
        uint256 b = DECIMAL_BASE;
        while (n != 0) {
            if (n & 1 == 1) r = Math.mulDiv(r, b, WAD60);
            n >>= 1;
            if (n != 0) b = Math.mulDiv(b, b, WAD60);
        }
    }

    /// @dev 1.0001^tick scaled by 1e60 for |tick| up to 300,000 (values between 1e-13 and 1e13).
    function decimalPowSigned(int256 tick) internal pure returns (uint256) {
        if (tick >= 0) return decimalPow(uint256(tick));
        return Math.mulDiv(WAD60, WAD60, decimalPow(uint256(-tick)));
    }

    /// @dev True when m1 * 2^e1 and m2 * 2^e2 agree to REL_TOLERANCE.
    function closeBinary(uint256 m1, int256 e1, uint256 m2, int256 e2) internal pure returns (bool) {
        uint256 a;
        uint256 b;
        if (e1 == e2) {
            (a, b) = (m1, m2);
        } else if (e1 == e2 + 1) {
            (a, b) = (m1 * 2, m2);
        } else if (e2 == e1 + 1) {
            (a, b) = (m1, m2 * 2);
        } else {
            return false;
        }
        uint256 diff = a > b ? a - b : b - a;
        return diff * REL_TOLERANCE <= b;
    }

    function assertNormalised(uint256 m) internal pure {
        assertGe(m, uint256(1) << 127, "mantissa below 2^127");
        assertLt(m, uint256(1) << 128, "mantissa at or above 2^128");
    }
}

/// @notice TickPower against an independent 200 digit Python computation and a decimal Solidity one.
contract UniswapV3TwapFeedTickMathTest is TwapFeedTestBase {
    TickPowerHarness internal h;

    function setUp() public {
        h = new TickPowerHarness();
    }

    function test_baseConstantIsOnePointZeroZeroZeroOneRoundedToNearest() public pure {
        uint256 numerator = uint256(10001) << 127;
        uint256 floorValue = numerator / 10000;
        uint256 remainder = numerator % 10000;
        uint256 nearest = remainder * 2 >= 10000 ? floorValue + 1 : floorValue;
        assertEq(TickPower.BASE_MANTISSA, nearest);
        // Hard-coded from python3 Decimal at 200 digits: floor(1.0001 * 2^127) and its fraction .5728.
        assertEq(floorValue, 170158197578815278654860472446255694138);
        assertEq(TickPower.BASE_MANTISSA, 170158197578815278654860472446255694139);
    }

    /// @dev Reference values generated by python3 Decimal (precision 200): for each tick the exact
    ///      floor of 1.0001^tick / 2^e with e chosen so the mantissa lies in [2^127, 2^128).
    function test_matchesPythonReferenceTable() public view {
        _ref(0, 170141183460469231731687303715884105728, -127);
        _ref(1, 170158197578815278654860472446255694138, -127);
        _ref(-1, 340248342086729790484326174814286782777, -128);
        _ref(2, 170175213398573160182725958493500319707, -127);
        _ref(-2, 340214320654664324051920982716015181259, -128);
        _ref(10, 170311401227882773583473761951235433122, -127);
        _ref(-10, 339942271634481534171944261107495351298, -128);
        _ref(100, 171851044862329067212731102936821250900, -127);
        _ref(-100, 336896669234911992640369586824150439382, -128);
        _ref(1000, 188034147817068120001184916236320548012, -127);
        _ref(-1000, 307901757690220954445983032425914523422, -128);
        _ref(12345, 292340635378588272400143667221620374647, -126);
        _ref(-12345, 198043096347797506852571598671489259968, -129);
        _ref(65536, 233125351956891822559423839007288128611, -118);
        _ref(-65536, 248347269538337880446081886223346698396, -137);
        _ref(82950, 332485042730840586493546508079385238692, -116);
        _ref(-82950, 174131275630125622623934703738026217413, -139);
        _ref(100000, 228621566560218301253064144141397184813, -113);
        _ref(-100000, 253239646153016961374568093294038973977, -142);
        _ref(193670, 326257329002712012495340984913529076072, -100);
        _ref(-193670, 177455154174258678848873436432571966810, -155);
        _ref(200000, 307202639792336247311691586309729094024, -99);
        _ref(-200000, 188462067441200498394226866235266233413, -156);
        _ref(300000, 206396674021832012377229148732556343131, -84);
        _ref(-300000, 280508612326446840977462321484432941212, -171);
        _ref(500000, 186332320647683820613247908612490028810, -55);
        _ref(-500000, 310713913814918007216590051472097813593, -200);
        _ref(524287, 264190063358686843606542841463162084937, -52);
        _ref(-524287, 219145428418530320353265059596186605532, -203);
        _ref(524288, 264216482365022712290903495747308401145, -52);
        _ref(-524288, 219123516066923627990466012994887116820, -203);
        _ref(777777, 195968853297075425405303996629302746793, -15);
        _ref(-777777, 295434930830011236305359931431800329255, -240);
        _ref(887271, 340222764559932100840721712881658375229, 0);
        _ref(-887271, 170170989861730409833369140499850883408, -255);
        _ref(887272, 340256786836388094050805785052946541066, 0);
        _ref(-887272, 170153974464283981435225617938057077700, -255);
    }

    function _ref(int256 tick, uint256 mantissa, int256 exponent) internal view {
        (uint256 m, int256 e) = h.pow(tick);
        assertNormalised(m);
        assertTrue(closeBinary(m, e, mantissa, exponent), string.concat("tick ", vm.toString(tick)));
    }

    /// @dev The gold range: PAXG, XAUT and their quotes at 6 or 18 decimals sit within |tick| 300,000.
    function testFuzz_goldRangeMatchesDecimalReference(int256 tick) public view {
        tick = bound(tick, -300_000, 300_000);
        (uint256 m, int256 e) = h.pow(tick);
        assertNormalised(m);
        assertLt(e, 0);
        uint256 binaryAs60 = Math.mulDiv(m, WAD60, uint256(1) << uint256(-e));
        uint256 expectedValue = decimalPowSigned(tick);
        uint256 diff = binaryAs60 > expectedValue ? binaryAs60 - expectedValue : expectedValue - binaryAs60;
        assertLe(diff * REL_TOLERANCE, expectedValue, "relative error above 1e-30");
    }

    /// @dev Across the whole range each step up multiplies by exactly 1.0001 to 1e-30.
    function testFuzz_stepIsOnePointZeroZeroZeroOne(int256 tick) public view {
        tick = bound(tick, -TickPower.MAX_TICK, TickPower.MAX_TICK - 1);
        (uint256 m0, int256 e0) = h.pow(tick);
        (uint256 m1, int256 e1) = h.pow(tick + 1);
        assertNormalised(m0);
        assertNormalised(m1);
        // Strictly increasing: a higher exponent, or the same exponent and a larger mantissa.
        assertTrue(e1 > e0 || (e1 == e0 && m1 > m0), "not increasing");
        uint256 expected = Math.mulDiv(m0, 10001, 10000);
        int256 expectedExp = e0;
        if (expected >= uint256(1) << 128) {
            expected >>= 1;
            expectedExp += 1;
        }
        assertTrue(closeBinary(m1, e1, expected, expectedExp), "step ratio");
    }

    /// @dev 1.0001^t * 1.0001^-t is 1 to 1e-30 across the whole range, extremes included.
    function testFuzz_reciprocalSymmetry(int256 tick) public view {
        tick = bound(tick, -TickPower.MAX_TICK, TickPower.MAX_TICK);
        (uint256 mp, int256 ep) = h.pow(tick);
        (uint256 mn, int256 en) = h.pow(-tick);
        (uint256 m, int256 e) = h.multiply(mp, ep, mn, en);
        assertTrue(closeBinary(m, e, uint256(1) << 127, -127), "product is not one");
    }

    /// @dev 1.0001^a * 1.0001^b equals 1.0001^(a+b) to 1e-30.
    function testFuzz_additive(int256 a, int256 b) public view {
        a = bound(a, -TickPower.MAX_TICK, TickPower.MAX_TICK);
        // b keeps a + b inside the range: [max(-MAX, -MAX - a), min(MAX, MAX - a)].
        int256 low = a > 0 ? -TickPower.MAX_TICK : -TickPower.MAX_TICK - a;
        int256 high = a > 0 ? TickPower.MAX_TICK - a : TickPower.MAX_TICK;
        b = bound(b, low, high);
        (uint256 ma, int256 ea) = h.pow(a);
        (uint256 mb, int256 eb) = h.pow(b);
        (uint256 mab, int256 eab) = h.pow(a + b);
        (uint256 m, int256 e) = h.multiply(ma, ea, mb, eb);
        assertTrue(closeBinary(m, e, mab, eab), "not additive");
    }

    function test_reciprocalOfAPowerOfTwoRenormalises() public view {
        (uint256 m, int256 e) = h.reciprocal(uint256(1) << 127, -130);
        assertEq(m, uint256(1) << 127);
        assertEq(e, -124);
    }

    function testFuzz_outOfRangeTicksRevert(int256 tick) public {
        vm.assume(tick > TickPower.MAX_TICK || tick < -TickPower.MAX_TICK);
        vm.assume(tick != type(int256).min);
        vm.expectRevert(abi.encodeWithSelector(TickPower.TickOutOfRange.selector, tick));
        h.pow(tick);
    }
}

/// @notice The feed end to end against mock pools, quote feeds and tokens.
contract UniswapV3TwapFeedTest is TwapFeedTestBase {
    uint32 internal constant WINDOW = 30 minutes;
    uint128 internal constant MIN_LIQ = 1e15;
    uint256 internal constant QUOTE_AGE = 1 days;
    uint32 internal constant OBS_AGE = 6 hours;
    uint32 internal constant SUB = WINDOW / 6;

    function setUp() public {
        vm.warp(1_800_000_000);
    }

    struct Setup {
        UniswapV3TwapFeed feed;
        MockUniswapV3Pool pool;
        MockSwitchableAggregatorV3 quoteFeed;
    }

    function _build(bool baseIsToken0, uint8 baseDec, uint8 quoteDec, uint256 quoteUsd, bool withFeed)
        internal
        returns (Setup memory s)
    {
        MockERC20 base = new MockERC20("Base", "BASE", baseDec);
        MockERC20 quote = new MockERC20("Quote", "QUOTE", quoteDec);
        s.pool = baseIsToken0
            ? new MockUniswapV3Pool(address(base), address(quote))
            : new MockUniswapV3Pool(address(quote), address(base));
        s.pool.setLiquidity(1e24);
        address feedAddress;
        uint256 age;
        if (withFeed) {
            s.quoteFeed = new MockSwitchableAggregatorV3(8);
            s.quoteFeed.setRound(7, int256(quoteUsd), block.timestamp, 7);
            feedAddress = address(s.quoteFeed);
            age = QUOTE_AGE;
        }
        s.feed = new UniswapV3TwapFeed(address(s.pool), address(base), WINDOW, MIN_LIQ, feedAddress, age, OBS_AGE, "TEST / USD");
    }

    /// @dev Python Decimal references (see test_matchesPythonReferenceTable for the method): the exact
    ///      floor of 1.0001^baseTick * 10^baseDecimals * quoteUsd / 10^quoteDecimals.
    function test_answersMatchPythonReferences() public {
        _ans(-193349, true, 18, 6, 100000000, 401217110502); // PAXG/USDC, PAXG token0
        _ans(193349, false, 18, 6, 100000000, 401217110502); // PAXG/USDC, PAXG token1
        _ans(82943, true, 6, 6, 99980000, 399854287562); // XAUT/USDT with a USDT/USD feed
        _ans(-2876, false, 18, 18, 300000000000, 399961421263); // PAXG/WETH with ETH/USD
        _ans(276304, true, 6, 18, 400500000000, 399698783697); // XAUT/PAXG with PAXG/USD
        _ans(-276304, false, 6, 18, 400500000000, 399698783697); // the same, token order swapped
        _ans(-320308, true, 18, 6, 100000000, 1229973); // a cheap base token
        _ans(-621729, false, 0, 18, 100000000, 99999405140591750); // a dear base token
    }

    function _ans(int24 poolTick, bool base0, uint8 bd, uint8 qd, uint256 q, uint256 expected) internal {
        bool withFeed = !(qd == 6 && q == 1e8);
        Setup memory s = _build(base0, bd, qd, q, withFeed);
        s.pool.setTick(poolTick);
        (uint80 roundId, int256 answer, uint256 startedAt, uint256 updatedAt, uint80 answeredInRound) =
            s.feed.latestRoundData();
        assertLe(uint256(answer), expected, "above the exact floor");
        assertGe(uint256(answer) + 1, expected, "more than one unit below");
        assertEq(roundId, block.timestamp);
        assertEq(answeredInRound, block.timestamp);
        assertEq(startedAt, block.timestamp);
        assertEq(updatedAt, block.timestamp);
    }

    /// @dev Both token orders, 6 and 18 decimals, with and without a quote feed, over the gold range,
    ///      against the decimal expectedValue.
    function testFuzz_bothOrdersAndDecimalsMatchReference(
        int256 baseTick,
        bool sixBase,
        bool sixQuote,
        uint256 quoteUsd,
        bool withFeed
    ) public {
        baseTick = bound(baseTick, -300_000, 300_000);
        uint8 bd = sixBase ? 6 : 18;
        uint8 qd = sixQuote ? 6 : 18;
        if (!sixQuote) withFeed = true;
        quoteUsd = withFeed ? bound(quoteUsd, 1e6, 1e13) : 1e8;
        Setup memory a = _build(true, bd, qd, quoteUsd, withFeed);
        Setup memory b = _build(false, bd, qd, quoteUsd, withFeed);
        a.pool.setTick(int24(baseTick));
        b.pool.setTick(int24(-baseTick));
        (uint256 answerA, UniswapV3TwapFeed.Status statusA) = a.feed.readPrice();
        (uint256 answerB, UniswapV3TwapFeed.Status statusB) = b.feed.readPrice();
        assertEq(answerA, answerB, "token order changed the answer");
        assertEq(uint8(statusA), uint8(statusB));

        // Split the 1e60 scale in two so no intermediate passes 2^256.
        uint256 scaledPartial = Math.mulDiv(decimalPowSigned(baseTick), (10 ** bd) * quoteUsd, 1e30);
        uint256 expectedValue = scaledPartial / ((10 ** qd) * 1e30);
        if (expectedValue >= 2 && expectedValue < 1e20) {
            assertEq(uint8(statusA), uint8(UniswapV3TwapFeed.Status.OK));
            uint256 diff = answerA > expectedValue ? answerA - expectedValue : expectedValue - answerA;
            assertLe(diff, 1 + expectedValue / 1e25, "answer off the expectedValue");
        } else if (expectedValue == 0 || expectedValue > 1e20 + 1) {
            assertEq(answerA, 0);
            assertEq(uint8(statusA), uint8(UniswapV3TwapFeed.Status.PRICE_OUT_OF_RANGE));
        }
    }

    /// @dev Any accumulator state, liquidity or tick, extremes included: the read never reverts and a
    ///      non zero answer only ever comes with status OK.
    function testFuzz_neverRevertsAndZeroUnlessOk(
        int24 tick,
        uint128 liquidity,
        int56 tickAnchor,
        uint160 liquidityAnchor,
        bool baseIsToken0,
        bool sixBase
    ) public {
        Setup memory s = _build(baseIsToken0, sixBase ? 6 : 18, 6, 1e8, false);
        s.pool.setTick(tick);
        s.pool.setLiquidity(liquidity);
        s.pool.setAnchors(tickAnchor, liquidityAnchor);
        (, int256 answer,,,) = s.feed.latestRoundData();
        (uint256 price, UniswapV3TwapFeed.Status status) = s.feed.readPrice();
        assertEq(uint256(answer), price);
        if (price != 0) assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.OK));
        if (status == UniswapV3TwapFeed.Status.OK) {
            assertGt(price, 0);
            assertLe(price, 1e20);
        }
    }

    /// @dev Wrapped accumulators still give the right mean tick and harmonic liquidity.
    function testFuzz_wrappingAccumulators(int24 tick, uint128 liquidity) public {
        tick = int24(bound(tick, -887_272, 887_272));
        liquidity = uint128(bound(liquidity, MIN_LIQ, type(uint64).max));
        Setup memory s = _build(true, 18, 6, 1e8, false);
        s.pool.setTick(tick);
        s.pool.setLiquidity(liquidity);
        // Anchors at the bottom of each accumulator's range, so looking back wraps both of them.
        s.pool.setAnchors(type(int56).min + 5, 3);
        (int256 meanTick, uint256 harmonic, UniswapV3TwapFeed.Status status) = s.feed.observeWindow();
        assertEq(meanTick, tick);
        assertEq(harmonic, liquidity);
        assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.OK));
    }

    /// @dev Seven point raw observation arrays from six sub-window mean ticks (times the sub-window) and
    ///      one liquidity for the whole window; `remainder` is added to the last cumulative so the final
    ///      sub-window's mean carries a fraction.
    function _raw(int256[6] memory subTicks, uint128 liquidity, int256 remainder)
        internal
        pure
        returns (int56[] memory ticks, uint160[] memory liq)
    {
        ticks = new int56[](7);
        liq = new uint160[](7);
        int256 cumulative = 0;
        for (uint256 i = 0; i < 6; i++) {
            cumulative += subTicks[i] * int256(uint256(SUB));
            ticks[i + 1] = int56(cumulative);
            liq[i + 1] = uint160(((uint256(SUB) * (i + 1)) << 128) / liquidity);
        }
        ticks[6] = int56(int256(ticks[6]) + remainder);
    }

    /// @dev The mean tick rounds towards negative infinity, as Uniswap's does.
    function testFuzz_meanTickRoundsTowardsNegativeInfinity(int24 tick, uint32 remainder) public {
        tick = int24(bound(tick, -887_000, 887_000));
        remainder = uint32(bound(remainder, 1, SUB - 1));
        Setup memory s = _build(true, 18, 6, 1e8, false);
        int256[6] memory subTicks = [int256(tick), tick, tick, tick, tick, tick];

        (int56[] memory ticks, uint160[] memory liq) = _raw(subTicks, 1e18, int256(uint256(remainder)));
        s.pool.setRawObservations(ticks, liq);
        (int256 up,,) = s.feed.observeWindow();
        assertEq(up, tick, "a positive remainder must floor to the tick");

        (ticks, liq) = _raw(subTicks, 1e18, -int256(uint256(remainder)));
        s.pool.setRawObservations(ticks, liq);
        (int256 down,,) = s.feed.observeWindow();
        // One sub-window floors to tick - 1; the median of five ticks and one tick - 1 is still tick.
        assertEq(down, tick, "one floored sub-window must not move the median");
    }

    /// @dev One, two or three extreme sub-windows cannot move the median off the quiet ticks.
    function testFuzz_medianIgnoresUpToThreeExtremeSubWindows(int24 quiet, int24 extreme, uint8 count, uint8 start) public {
        quiet = int24(bound(quiet, -600_000, 600_000));
        extreme = int24(bound(extreme, -887_000, 887_000));
        count = uint8(bound(count, 1, 3));
        start = uint8(bound(start, 0, 6 - count));
        Setup memory s = _build(true, 18, 6, 1e8, false);
        int256[6] memory subTicks;
        for (uint256 i = 0; i < 6; i++) {
            subTicks[i] = (i >= start && i < start + count) ? int256(extreme) : int256(quiet);
        }
        (int56[] memory ticks, uint160[] memory liq) = _raw(subTicks, 1e18, 0);
        s.pool.setRawObservations(ticks, liq);
        (int256 median,, UniswapV3TwapFeed.Status status) = s.feed.observeWindow();
        assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.OK));
        if (count < 3) {
            assertEq(median, quiet, "fewer than three pushed sub-windows must not move the median");
        } else {
            // Three and three: the median is the floor mean of the two, so it moves by half the push.
            int256 low = quiet < extreme ? int256(quiet) : int256(extreme);
            int256 high = quiet < extreme ? int256(extreme) : int256(quiet);
            assertGe(median, low);
            assertLe(median, high);
            assertEq(median, (int256(quiet) + int256(extreme)) >> 1);
        }
    }

    /// @dev The median is the floor mean of the third and fourth sorted sub-window means, whatever the order.
    function testFuzz_medianMatchesSortedDefinition(int24[6] memory raw) public {
        int256[6] memory subTicks;
        for (uint256 i = 0; i < 6; i++) subTicks[i] = bound(int256(raw[i]), -887_000, 887_000);
        Setup memory s = _build(true, 18, 6, 1e8, false);
        (int56[] memory ticks, uint160[] memory liq) = _raw(subTicks, 1e18, 0);
        s.pool.setRawObservations(ticks, liq);
        (int256 median,,) = s.feed.observeWindow();
        int256[6] memory sorted = subTicks;
        for (uint256 i = 1; i < 6; i++) {
            for (uint256 j = i; j > 0 && sorted[j - 1] > sorted[j]; j--) {
                (sorted[j - 1], sorted[j]) = (sorted[j], sorted[j - 1]);
            }
        }
        assertEq(median, (sorted[2] + sorted[3]) >> 1);
    }

    /// @dev A pool whose latest observation is older than maxObservationAge answers 0, never its last tick.
    function testFuzz_staleObservationIsInvalid(uint32 age) public {
        age = uint32(bound(age, 0, 3 days));
        Setup memory s = _build(true, 18, 6, 1e8, false);
        s.pool.setTick(-193_349);
        s.pool.setLiquidity(1e20); // about 12.7 billion USD of virtual reserves, inside the depth cap
        s.pool.setLastObservation(uint32(block.timestamp) - age, true);
        (uint256 reportedAge, UniswapV3TwapFeed.Status ageStatus) = s.feed.lastObservationAge();
        assertEq(reportedAge, age);
        (uint256 price, UniswapV3TwapFeed.Status status) = s.feed.readPrice();
        (uint256 depth, UniswapV3TwapFeed.Status depthStatus) = s.feed.liquidityUsd();
        if (age > OBS_AGE) {
            assertEq(uint8(ageStatus), uint8(UniswapV3TwapFeed.Status.NO_RECENT_SWAPS));
            assertEq(price, 0);
            assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.NO_RECENT_SWAPS));
            assertEq(depth, 0);
            assertEq(uint8(depthStatus), uint8(UniswapV3TwapFeed.Status.NO_RECENT_SWAPS));
        } else {
            assertEq(uint8(ageStatus), uint8(UniswapV3TwapFeed.Status.OK));
            assertGt(price, 0);
            assertGt(depth, 0);
        }
    }

    /// @dev Python Decimal references (ref/depth.py): floor(2 * L * 1.0001^(t/2) * quoteUsd * 1e10 / 10^qd)
    ///      with t the quote side tick. The contract floors the quote side to a raw unit first, so it may
    ///      sit below the reference by up to 2 * quoteUsd * 1e10 / 10^qd plus one.
    function test_liquidityValueMatchesPythonReferences() public {
        _depth(1000000000000000000, -193349, true, 18, 6, 100000000, 126683402307089053545841102);
        _depth(1000000000000000000, 193349, false, 18, 6, 100000000, 126683402307089053545841102);
        _depth(500000000000000000000, -2876, false, 18, 18, 300000000000, 3463934560279295295723986);
        _depth(3000000000000000, 82943, true, 6, 6, 99980000, 379366253130081756381175833975);
        _depth(70000000000000000000, 276304, true, 6, 18, 400500000000, 560138867805937799024796186954);
        _depth(1000000000000, -193349, true, 18, 6, 100000000, 126683402307089053545);
        _depth(1000000000000000000000000, 0, true, 18, 18, 100000000, 2000000000000000000000000);
    }

    function _depth(uint256 liquidity, int256 poolTick, bool base0, uint8 bd, uint8 qd, uint256 q, uint256 expected) internal {
        Setup memory s = _build(base0, bd, qd, q, !(qd == 6 && q == 1e8));
        (uint256 usd18, UniswapV3TwapFeed.Status status) = s.feed.liquidityValueAtTick(poolTick, liquidity, q);
        assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.OK));
        uint256 slack = (2 * q * 1e10) / (10 ** qd) + 1;
        assertLe(usd18, expected, "above the exact floor");
        assertGe(usd18 + slack, expected, "below the reference by more than one raw quote unit");
    }

    function test_liquidityValueEdges() public {
        Setup memory s = _build(true, 18, 6, 1e8, false);
        (uint256 usd18, UniswapV3TwapFeed.Status status) = s.feed.liquidityValueAtTick(-887272, 1, 1e8);
        assertEq(usd18, 0);
        assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.PRICE_OUT_OF_RANGE));
        (usd18, status) = s.feed.liquidityValueAtTick(887272, type(uint128).max, 1e8);
        assertEq(usd18, 0);
        assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.PRICE_OUT_OF_RANGE));
        (, status) = s.feed.liquidityValueAtTick(0, 0, 1e8);
        assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.BAD_OBSERVATION));
        (, status) = s.feed.liquidityValueAtTick(0, uint256(type(uint128).max) + 1, 1e8);
        assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.BAD_OBSERVATION));
        (, status) = s.feed.liquidityValueAtTick(887273, 1e18, 1e8);
        assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.TICK_OUT_OF_RANGE));
        (, status) = s.feed.liquidityValueAtTick(0, 1e18, 0);
        assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.QUOTE_INVALID));
    }

    /// @dev Across the whole tick range and liquidity range the value never reverts, is 0 only with a
    ///      non OK status and agrees with the decimal reference of L * 1.0001^(t/2) where it is in range.
    function testFuzz_liquidityValueNeverRevertsAndMatchesReference(int256 tick, uint128 liquidity, bool base0) public {
        tick = bound(tick, -TickPower.MAX_TICK, TickPower.MAX_TICK);
        Setup memory s = _build(base0, 18, 6, 1e8, false);
        (uint256 usd18, UniswapV3TwapFeed.Status status) = s.feed.liquidityValueAtTick(tick, liquidity, 1e8);
        if (usd18 != 0) assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.OK));
        if (status == UniswapV3TwapFeed.Status.OK) {
            assertGt(usd18, 0);
            assertLe(usd18, 1e32);
        }
        int256 quoteTick = base0 ? tick : -tick;
        if (quoteTick >= -300_000 && quoteTick <= 300_000 && liquidity > 0) {
            // usd18 = 2 * quoteSide * 1e8 * 1e10 / 1e6, so quoteSide = usd18 / 2e12; (quoteSide / L)^2 is P.
            (uint256 m, int256 e) = TickPower.pow(quoteTick);
            uint256 priceAs30 = Math.mulDiv(m, 1e30, uint256(1) << uint256(-e));
            uint256 quoteSide = usd18 / 2e12;
            if (quoteSide > 1e6 && status == UniswapV3TwapFeed.Status.OK) {
                uint256 ratio30 = Math.mulDiv(quoteSide, 1e30, liquidity);
                uint256 squared30 = Math.mulDiv(ratio30, ratio30, 1e30);
                uint256 diff = squared30 > priceAs30 ? squared30 - priceAs30 : priceAs30 - squared30;
                // Flooring quoteSide to an integer costs up to 1 / quoteSide relative, doubled by squaring.
                assertLe(diff, (priceAs30 * 3) / quoteSide + 2, "value off the reference");
            }
        }
    }

    /// @dev Thin pools read as 0 and the boundary is exact.
    function testFuzz_thinLiquidityIsInvalid(uint128 liquidity) public {
        liquidity = uint128(bound(liquidity, 1, uint256(MIN_LIQ) * 4));
        Setup memory s = _build(true, 18, 6, 1e8, false);
        s.pool.setTick(-193_349);
        s.pool.setLiquidity(liquidity);
        (uint256 price, UniswapV3TwapFeed.Status status) = s.feed.readPrice();
        if (liquidity < MIN_LIQ) {
            assertEq(price, 0);
            assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.THIN_LIQUIDITY));
        } else {
            assertGt(price, 0);
            assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.OK));
        }
    }

    /// @dev A quote answer older than maxQuoteAge reads as 0, never as the last fresh price.
    function testFuzz_staleQuoteIsInvalid(uint256 age) public {
        age = bound(age, 0, 30 days);
        Setup memory s = _build(false, 18, 18, 3000e8, true);
        s.pool.setTick(-2876);
        s.quoteFeed.setRound(9, 3000e8, block.timestamp - age, 9);
        (uint256 price, UniswapV3TwapFeed.Status status) = s.feed.readPrice();
        if (age > QUOTE_AGE) {
            assertEq(price, 0);
            assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.QUOTE_STALE));
        } else {
            assertGt(price, 0);
            assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.OK));
        }
    }

    function test_oldObservationIsInvalid() public {
        Setup memory s = _build(true, 18, 6, 1e8, false);
        s.pool.setTick(-193_349);
        s.pool.setRevertOld(true);
        (, int256 answer,,,) = s.feed.latestRoundData();
        assertEq(answer, 0);
        (, UniswapV3TwapFeed.Status status) = s.feed.readPrice();
        assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.OBSERVE_FAILED));
    }

    function test_failingQuoteFeedIsInvalid() public {
        Setup memory s = _build(false, 18, 18, 3000e8, true);
        s.pool.setTick(-2876);
        s.quoteFeed.setReverting(true);
        (uint256 price, UniswapV3TwapFeed.Status status) = s.feed.readPrice();
        assertEq(price, 0);
        assertEq(uint8(status), uint8(UniswapV3TwapFeed.Status.QUOTE_FEED_FAILED));
    }
