pragma solidity 0.8.38;

import "forge-std/Test.sol";

import {RpowHarness} from "../../src/test/mocks/RpowHarness.sol";

/// @title _rpow differential test
/// @notice Asserts `StabilityModule._rpow` matches a mpmath reference to within
///         a tight absolute tolerance. The reference table is generated by
///         `contracts/tools/generate_rpow_vectors.py` and baked in here.
///
///         Rebuild the table after any change to `_rpow` with:
///             python3 contracts/tools/generate_rpow_vectors.py
///         then paste the `_vectors()` body into this file.
///
/// @dev Tolerance rationale: `_rpow` rounds half-up once per squaring and once per
///         multiplication into the result, each by at most half a unit of 1e-18. The
///         error of a squared term is doubled by the next squaring, so after k squarings
///         it is at most (2^k - 1) half units, and the product over the set bits of n adds
///         up to at most n half units, relative to the result. The tolerance is that bound:
///         n * expected / 2e18 units, plus one for the reference's own rounding. For a
///         year of seconds that is about 1.6e7 units of 1e-18 (the observed drift is a few
///         million); for one hour it is 1,800. An exponent of 1 or 2 has at most one
///         rounding, so those results are checked exactly below.
contract RpowDifferentialTest is Test {
    RpowHarness internal harness;

    /// @dev The bound derived above: n half-units of 1e-18 relative to the result, plus one.
    function _tolerance(uint256 n, uint256 expected) internal pure returns (uint256) {
        return n * expected / 2e18 + 1;
    }

    struct RpowVector {
        uint256 perSecondRate;
        uint256 elapsedSeconds;
        uint256 expected;
    }

    function setUp() public {
        harness = new RpowHarness();
    }

    // ==================================================================
    // Auto-generated vectors - see tools/generate_rpow_vectors.py
    // ==================================================================

    function _vectors() internal pure returns (RpowVector[] memory v) {
        v = new RpowVector[](19);
        v[0] = RpowVector({perSecondRate: 1000000000000000000, elapsedSeconds: 0, expected: 1000000000000000000}); // 0 bps APR, 0s
        v[1] = RpowVector({perSecondRate: 1000000000000000000, elapsedSeconds: 31536000, expected: 1000000000000000000}); // 0 bps APR, 31536000s
        v[2] = RpowVector({perSecondRate: 1000000000317097919, elapsedSeconds: 0, expected: 1000000000000000000}); // 100 bps APR, 0s
        v[3] = RpowVector({perSecondRate: 1000000000317097919, elapsedSeconds: 3600, expected: 1000001141553159790}); // 100 bps APR, 3600s
        v[4] = RpowVector({perSecondRate: 1000000000317097919, elapsedSeconds: 86400, expected: 1000027397635505617}); // 100 bps APR, 86400s
        v[5] = RpowVector({perSecondRate: 1000000000634195839, elapsedSeconds: 31536000, expected: 1020201339998559528}); // 200 bps APR, 31536000s
        v[6] = RpowVector({perSecondRate: 1000000000634195839, elapsedSeconds: 157680000, expected: 1105170917922924286}); // 200 bps APR, 157680000s
        v[7] = RpowVector({perSecondRate: 1000000001585489599, elapsedSeconds: 31536000, expected: 1051271096328114210}); // 500 bps APR, 31536000s
        v[8] = RpowVector({perSecondRate: 1000000003170979198, elapsedSeconds: 31536000, expected: 1105170917887303337}); // 1000 bps APR, 31536000s
        v[9] = RpowVector({perSecondRate: 1000000003170979198, elapsedSeconds: 94608000, expected: 1349858806885870404}); // 1000 bps APR, 94608000s
        v[10] = RpowVector({perSecondRate: 1000000015854895991, elapsedSeconds: 31536000, expected: 1648721264119178143}); // 5000 bps APR, 31536000s
        v[11] = RpowVector({perSecondRate: 1000000015854895991, elapsedSeconds: 63072000, expected: 2718281806758740772}); // 5000 bps APR, 63072000s
        v[12] = RpowVector({perSecondRate: 1000000000634195839, elapsedSeconds: 1, expected: 1000000000634195839}); // 200 bps APR, 1s
        v[13] = RpowVector({perSecondRate: 1000000000317097919, elapsedSeconds: 3601, expected: 1000001141870258071}); // 100 bps APR, 3601s
        v[14] = RpowVector({perSecondRate: 1000000000634195839, elapsedSeconds: 86399, expected: 1000054795387488792}); // 200 bps APR, 86399s
        v[15] = RpowVector({perSecondRate: 1000000000634195839, elapsedSeconds: 31535999, expected: 1020201339351552084}); // 200 bps APR, 31535999s
        v[16] = RpowVector({perSecondRate: 1000000003170979198, elapsedSeconds: 31535999, expected: 1105170914382829357}); // 1000 bps APR, 31535999s
        v[17] = RpowVector({perSecondRate: 1000000015854895991, elapsedSeconds: 31535999, expected: 1648721237978874396}); // 5000 bps APR, 31535999s
        v[18] = RpowVector({perSecondRate: 1000000015854895991, elapsedSeconds: 63071999, expected: 2718281763660666134}); // 5000 bps APR, 63071999s
    }

    // ==================================================================
    // Tests
    // ==================================================================

    function test_rpowMatchesReferenceVectors() public view {
        RpowVector[] memory v = _vectors();
        for (uint256 i = 0; i < v.length; i++) {
            uint256 actual = harness.rpow(v[i].perSecondRate, v[i].elapsedSeconds);
            assertApproxEqAbs(
                actual,
                v[i].expected,
                _tolerance(v[i].elapsedSeconds, v[i].expected),
                string.concat("rpow mismatch at vector index ", vm.toString(i))
            );
        }
    }

    /// @notice An exponent of 1 returns x itself, and each multiplication rounds half-up:
    ///         with one or two roundings the result is exact, so it is compared exactly.
    function test_rpowSmallExponentsAreExact() public view {
        // (1 + 7.5e-10)^2 = 1 + 1.5e-9 + 5.625e-19: the last term is above half a unit and
        // rounds up.
        uint256 x = 1_000_000_000_750_000_000;
        assertEq(harness.rpow(x, 1), x, "x^1 is x");
        assertEq(harness.rpow(x, 2), 1_000_000_001_500_000_001, "x^2 rounds the half unit up");
        // (1 + 5e-10)^2 = 1 + 1e-9 + 2.5e-19: below half a unit, rounds down.
        assertEq(harness.rpow(1_000_000_000_500_000_000, 2), 1_000_000_001_000_000_000, "x^2 rounds a quarter unit down");
        // x^3 is x^2 (rounded) times x, rounded once more: 1 + 2.25e-9 + 1.6875e-18 + ...
        assertEq(harness.rpow(x, 3), 1000000002250000002, "x^3 is x times the rounded square, rounded half-up");
        // The per-second rates the module uses, for one and two seconds.
        uint256 rate = 1000000000634195839; // 200 bps a year
        assertEq(harness.rpow(rate, 1), rate);
        assertEq(harness.rpow(rate, 2), (rate * rate + 5e17) / 1e18);
    }

    /// @notice Boundary cases that are easy to get wrong in the assembly.
    function test_rpowBoundaries() public view {
        // n = 0 always returns 1e18 (unit element).
        assertEq(harness.rpow(0, 0), 1e18, "rpow(0, 0) != 1e18");
        assertEq(harness.rpow(1e18, 0), 1e18, "rpow(1e18, 0) != 1e18");
        assertEq(harness.rpow(2e18, 0), 1e18, "rpow(2e18, 0) != 1e18");

        // x = 0, n > 0 returns 0.
        assertEq(harness.rpow(0, 1), 0, "rpow(0, 1) != 0");
        assertEq(harness.rpow(0, 100), 0, "rpow(0, 100) != 0");

        // x = 1e18, any n returns 1e18 (multiplicative identity).
        assertEq(harness.rpow(1e18, 1), 1e18, "rpow(1e18, 1) != 1e18");
        assertEq(harness.rpow(1e18, 31_536_000), 1e18, "rpow(1e18, year) != 1e18");
    }
}
